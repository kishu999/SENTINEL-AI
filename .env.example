# SkillConnect Environment Variables Configuration
# Copy this file to .env.local to configure your local credentials.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe Payment Integration (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample123456789
STRIPE_SECRET_KEY=sk_test_sample123456789
STRIPE_WEBHOOK_SECRET=whsec_sample123456789

# Demo & Mock Persistence Layer
# When set to true, SkillConnect falls back to high-fidelity seedable demo store
# whenever Supabase environment variables are missing or unconfigured.
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true
